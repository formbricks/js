{
  "name": "js",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "turbo run check-types",
    "api:check": "pnpm --filter @formbricks/js api:check",
    "api:update": "pnpm --filter @formbricks/js api:update",
    "package-check": "pnpm --filter @formbricks/js package-check && ./scripts/consumer-check.sh",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:scripts": "node --test scripts/*.test.mjs scripts/release/*.test.mjs",
    "clean": "turbo run clean && rimraf node_modules .turbo coverage out"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "turbo": "2.9.14",
    "typescript": "6.0.2",
    "rimraf": "6.1.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@microsoft/api-extractor>minimatch": "11.0.1",
      "brace-expansion@5": "5.0.9",
      "nanoid@3": "3.3.19",
      "postcss": "8.5.28",
      "source-map-js": "1.2.2",
      "ws@8": "8.21.3"
    }
  }
}
